# jarvis-settings-server configuration

# Server settings
PORT=8014
HOST=0.0.0.0

# jarvis-config-service URL for service discovery
JARVIS_CONFIG_URL=http://localhost:8013

# JWT secret key - MUST match jarvis-auth SECRET_KEY
# This is required to validate superuser JWTs
JARVIS_AUTH_SECRET_KEY=your-secret-key-here

# JWT algorithm (should match jarvis-auth)
JARVIS_AUTH_ALGORITHM=HS256

# HTTP client timeout for service calls
SERVICE_TIMEOUT=10.0

# Logging
JARVIS_LOG_CONSOLE_LEVEL=INFO
JARVIS_LOG_REMOTE_LEVEL=DEBUG
JARVIS_APP_ID=jarvis-settings-server
JARVIS_APP_KEY=
